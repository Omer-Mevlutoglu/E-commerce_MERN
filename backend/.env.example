# Copy to .env and fill in. The server validates these at boot and refuses
# to start if anything is missing or malformed.

# Runtime mode: development | test | production
NODE_ENV=development

# Port the API listens on.
PORT=3001

# MongoDB connection string.
# A replica set (or MongoDB Atlas) enables transactional checkout.
# A standalone mongod still works — checkout falls back to compensating writes.
DATABASE_URL=mongodb://localhost:27017/laptopia

# Secret used to sign JWTs. MINIMUM 32 CHARACTERS.
# Generate one with:  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace-me-with-at-least-32-random-characters

# How long an issued token stays valid (zeit/ms format).
JWT_EXPIRES_IN=7d

# Comma-separated list of browser origins allowed to call this API.
CORS_ORIGIN=http://localhost:5173
